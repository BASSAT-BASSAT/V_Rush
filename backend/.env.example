# Copy this file to ``backend/.env`` and set the same values as your Supabase project / Vercel API env.
# JWT secret: Supabase → Project Settings → API → JWT Secret (Legacy JWT Secret; used to verify HS256 tokens).
SUPABASE_JWT_SECRET=

# Comma-separated browser origins allowed to call the API (required for Vercel + separate API host).
# Example: https://kernellab.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local dev without Supabase login: set to 1 (required if SUPABASE_JWT_SECRET is empty).
# Production with real auth: keep 0 and set SUPABASE_JWT_SECRET.
KERNELLAB_AUTH_DISABLED=1

MAX_IMAGE_BYTES=8388608
MAX_IMAGE_DIMENSION=8192

# Video annotation workbench: persist projects under backend/annotations/ (local git clone).
ENABLE_LOCAL_ANNOTATIONS=1
# LOCAL_ANNOTATIONS_DIR=/absolute/path/to/annotations
