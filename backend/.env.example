# Copy this file to ``backend/.env`` and set the same values as your Supabase project / Vercel API env.
# JWT secret: Supabase → Project Settings → API → JWT Secret (Legacy JWT Secret; used to verify HS256 tokens).
SUPABASE_JWT_SECRET=

# Comma-separated browser origins allowed to call the API (required for Vercel + separate API host).
# Example: https://kernellab.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 only for local dev / tests without Supabase (never in public production).
KERNELLAB_AUTH_DISABLED=0

MAX_IMAGE_BYTES=8388608
MAX_IMAGE_DIMENSION=4096
