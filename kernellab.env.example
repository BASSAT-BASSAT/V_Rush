# =============================================================================
# KernelLab — copy to kernellab.env, fill in, import to Vercel / use locally.
# Do not commit kernellab.env (see .gitignore).
# =============================================================================
#
# --- CV-only (no Supabase / no DB) ---
# Leave VITE_SUPABASE_* empty, set KERNELLAB_AUTH_DISABLED=1, omit SUPABASE_JWT_SECRET.
# See README "CV-only deploy".
#
# --- Frontend (Vite) ---
# Vercel Services (same domain): leave empty. Split API host: full API origin, no trailing slash.
VITE_API_BASE_URL=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend (FastAPI) ---
SUPABASE_JWT_SECRET=

# Local + production browser origins (comma, no spaces). After first Vercel deploy, append:
# ,https://YOUR_PROJECT.vercel.app   (use your real deployment URL; add custom domains too)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

KERNELLAB_AUTH_DISABLED=0
MAX_IMAGE_BYTES=8388608
MAX_IMAGE_DIMENSION=8192

# Optional: future hosted segmentation proxy (GET /api/segmentation/status reads these)
# SEGMENTATION_PROVIDER=replicate
# SEGMENTATION_API_URL=
# SEGMENTATION_API_KEY=
