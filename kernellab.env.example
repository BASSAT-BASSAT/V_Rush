# =============================================================================
# KernelLab — one file to copy, fill, and import (e.g. Vercel → Environment)
# Copy to kernellab.env (or .env), fill in values, do NOT commit filled files.
# Supabase: Project Settings → API (URL, anon key, JWT Secret).
# =============================================================================

# --- Frontend (Vite) — same-origin API on Vercel Services: leave empty ---
# Split deploy (API on Render etc.): https://your-api.example.com  (no trailing slash)
VITE_API_BASE_URL=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend (FastAPI) ---
# JWT Secret (not the anon key) — used only on the server to verify Bearer tokens
SUPABASE_JWT_SECRET=

# Comma-separated origins, no spaces. Local + production, e.g.:
# http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1 = local/tests without Supabase only — never on public production
KERNELLAB_AUTH_DISABLED=0

MAX_IMAGE_BYTES=8388608
MAX_IMAGE_DIMENSION=4096
